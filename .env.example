# Local: printed by `pnpm db:start` (API URL + publishable key)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Native app builds only (`pnpm native:sync`, values in .env.production.local): the live website's address,
# which invite links point at.
# VITE_APP_URL=https://your-site.vercel.app

# Web push (notifications on the website): the public half of the VAPID key pair whose private half is
# the push-dispatch function's VAPID_PRIVATE_KEY (supabase/functions/.env.example).
# VITE_VAPID_PUBLIC_KEY=
