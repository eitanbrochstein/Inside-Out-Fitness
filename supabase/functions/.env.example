# Secrets for supabase/functions/push-dispatch. Locally: copy to supabase/functions/.env and run
#   pnpm exec supabase functions serve push-dispatch --env-file supabase/functions/.env
# Hosted: set each with `pnpm exec supabase secrets set NAME=value` (see README → Notifications).

# Must match the push_dispatch_secret stored in the database's Vault.
PUSH_DISPATCH_SECRET=

# Apple (iOS): an APNs auth key (.p8) from developer.apple.com → Keys. Paste the key with \n for newlines.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.insideouttraining.app

# Firebase (Android): the whole service-account JSON, on one line.
FCM_SERVICE_ACCOUNT=

# Web push: from `pnpm dlx web-push generate-vapid-keys`. The public key also goes in VITE_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
